DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/nagode_transfert?schema=public"

JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

PORT=4000
NODE_ENV=development
# Base URL this server is reachable at (used to build absolute image URLs)
PUBLIC_URL="http://localhost:4000"

# Comma-separated list of allowed front-end origins
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"
# Set to true in production (HTTPS only cookies)
COOKIE_SECURE=false

# Used once by `npm run seed` to create the first admin account
ADMIN_SEED_NAME="Administrateur"
ADMIN_SEED_EMAIL="admin@nagodetransfert.com"
ADMIN_SEED_PASSWORD="ChangeMoi123!"

# Optional: if all three are set, uploaded images go to Cloudinary instead of local disk
# (recommended in production — Render's local disk is not persistent across deploys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: powers the "Nago" chat widget on the public site. Get a key at
# https://console.anthropic.com — without it, the widget shows a friendly
# "unavailable" message instead of erroring.
ANTHROPIC_API_KEY=
